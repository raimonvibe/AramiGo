# Base URL of the Spring API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical site origin (no trailing slash). Used for Open Graph / Twitter
# absolute image URLs when someone shares a link.
# Production: https://troubigue.com — leave blank locally and the code falls
# back to that, so share previews never point at a dev machine.
NEXT_PUBLIC_SITE_URL=

# OAuth 2.0 Web application client ID from the Google Cloud console.
# Leave unset to hide sign-in entirely — the app works fine as a guest.
# The same value must be set as GOOGLE_CLIENT_ID on the API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
