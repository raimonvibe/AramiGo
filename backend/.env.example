# Copy to backend/.env for local development (gitignored, never committed).
# In production set these in the Render dashboard instead.

# --- Database -------------------------------------------------------------
# Unset = throwaway in-memory H2. Fine locally; loses all progress on restart.
#
# Paste the provider's connection string as-is — the libpq form is converted to
# JDBC at startup, so both of these work:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#   DATABASE_URL=jdbc:postgresql://host/dbname?sslmode=require
#
# Keeping the password out of the URL and in DATABASE_PASSWORD is tidier, and
# the separate values take precedence over anything embedded in the URL.
#
# Free-tier note: Render's free Postgres expires 30 days after creation on a
# wall clock and is then deleted — pinging does not help. Neon has no expiry
# (idle compute just suspends and wakes on the next connection), which is why
# it pairs better with a free Render web service.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- CORS -----------------------------------------------------------------
# Comma-separated, no trailing slashes — a browser Origin header never has one.
# Production is https://aramaic.eu (add https://www.aramaic.eu too if the
# www host serves the app rather than redirecting).
ARAMIGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google sign-in -------------------------------------------------------
# OAuth 2.0 Web application client ID. Empty = sign-in hidden, guests only.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
# There is no client secret here: the API only verifies Google-signed ID tokens.
GOOGLE_CLIENT_ID=
